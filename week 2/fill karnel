from karel.stanfordkarel import *

def main():
    fill_row()
    return_to_left()
    turn_left()
    while front_is_clear():
        move()
        turn_right()
        fill_row()
        return_to_left()
        turn_left()
    turn_right()
    while front_is_clear():
        move()

def fill_row():
    put_beeper()
    while front_is_clear():
        move()
        put_beeper()

def return_to_left():
    turn_around()
    while front_is_clear():
        move()
    turn_around()

def turn_right():
    turn_left()
    turn_left()
    turn_left()

def turn_around():
    turn_left()
    turn_left()

if __name__ == '__main__':
    main()