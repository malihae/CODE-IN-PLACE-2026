from graphics import Canvas
import random

CANVAS_WIDTH = 450
CANVAS_HEIGHT = 300

def main():
    canvas = Canvas(CANVAS_WIDTH, CANVAS_HEIGHT)
    canvas.create_rectangle(
        0,                      # left_x
        0,                      # top_y
        CANVAS_WIDTH,           # right_x
        CANVAS_HEIGHT / 2,      # bottom_y
        "red"                   # color
    )    

if __name__ == '__main__':
    main()