def load_words_from_file(filepath):
    words = []
    with open(filepath, 'r') as file_reader:
        for line in file_reader.readlines():
            cleaned_line = line.strip()
            if cleaned_line != '':
                words.append(cleaned_line)
    return words


def clear_terminal():
    for i in range(20):
        print('\n')


if __name__ == '__main__':
    main()